diff --git a/src/plugins/ros2_plugin/ros2_plugin.cc b/src/plugins/ros2_plugin/ros2_plugin.cc
index a45816b..7981955 100644
--- a/src/plugins/ros2_plugin/ros2_plugin.cc
+++ b/src/plugins/ros2_plugin/ros2_plugin.cc
@@ -157,7 +157,12 @@ void Ros2Plugin::Shutdown() noexcept {
     default_context->shutdown("user called rclcpp::shutdown()");
     rclcpp::uninstall_signal_handlers();
 
-    ros2_thread_ptr_->join();
+    // The spin thread is created in the kPostStart hook. If startup aborts
+    // before that hook runs (e.g. a module Init failure), the pointer is still
+    // null and shutting down must not dereference it.
+    if (ros2_thread_ptr_ && ros2_thread_ptr_->joinable()) {
+      ros2_thread_ptr_->join();
+    }
   } catch (const std::exception& e) {
     AIMRT_ERROR("Shutdown failed, {}", e.what());
   }
